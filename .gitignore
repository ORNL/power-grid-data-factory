# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.venv/

# OS/editor
.DS_Store
.vscode/

# Runtime artifacts
core
*.core

# Generated data lifecycle tiers (see src/grid_data_factory/storage/paths.py).
# Keep the tier roots tracked (via .gitkeep) but ignore their generated contents.
data/outputs/*
!data/outputs/.gitkeep
data/scratch/*
!data/scratch/.gitkeep
!data/scratch/logs/
data/scratch/logs/*
!data/scratch/logs/.gitkeep
data/derived/*
!data/derived/.gitkeep

# External dependencies and large builds
external/

# Local build outputs
build/
build-*/
install/

# Julia local state
julia/.julia/
.julia_depot_*/

# Julia sysimages (large, machine-specific PackageCompiler output)
julia/sysimages/
julia/build/Manifest.toml
